# Notion API Credentials
NOTION_TOKEN=ntn_your_notion_integration_token_here
NOTION_DATABASE_ID=your_32_character_database_id_here

# Security (Optional password/PIN protection for public cloud deployment)
DRIVE_PASSWORD=my_secure_cloud_password_here

# Local Sync Settings
LOCAL_SYNC_PATH=C:\Users
LOCAL_SERVER_PORT=8765
INCLUDE_HIDDEN=true
POLL_INTERVAL_SECONDS=4
